"""
Control Brutalist Fountain: Pure Hard-Surface Geometry and High-Fidelity Animated Water.
Architecture per Matthieu's explicit doctrine:
- Stone: 100% pure Hard Surface (clean flat planar blocks, crisp 45-degree chamfer bevels, zero wavy mesh noise).
  The texture / Copernicus PBR graph handles all the chiseled cleavage, chipping and grain.
- Water: High-fidelity realistic fluid system:
  - 3 top reservoir pools with edge meniscus
  - Curved spillway weir with rounded overflow lip
  - Thick contoured cascading waterfall stream with downward velocity and turbulent flow
  - Impact plunge pool with bubbling foam ring (f@foam attribute)
  - Basin water plane with concentric capillary ripples and subsurface caustics attribute
  - Separate material tags: M_Control_BrutalistStone_01, M_Control_FountainWater_01
"""
import hou
import os

def build_fountain():
    obj = hou.node('/obj')
    
    fountain_geo = obj.node('Control_Brutalist_Fountain')
    if fountain_geo:
        fountain_geo.destroy()
        
    fountain_geo = obj.createNode('geo', 'Control_Brutalist_Fountain')
    for child in fountain_geo.children():
        child.destroy()
        
    # --- 1. PARAMETERS CONTROLLER ---
    null_parms = fountain_geo.createNode('null', 'CONTROLS')
    ptg = null_parms.parmTemplateGroup()
    
    # Basin parameters
    f_basin = hou.FolderParmTemplate('basin_folder', 'Basin (Hard Surface)')
    f_basin.addParmTemplate(hou.FloatParmTemplate('basin_width', 'Basin Width', 1, default_value=(2.10,), min=1.0, max=4.0))
    f_basin.addParmTemplate(hou.FloatParmTemplate('basin_length', 'Basin Length', 1, default_value=(2.10,), min=1.0, max=4.0))
    f_basin.addParmTemplate(hou.FloatParmTemplate('basin_height', 'Basin Height', 1, default_value=(0.38,), min=0.2, max=1.0))
    f_basin.addParmTemplate(hou.FloatParmTemplate('rim_thickness', 'Rim Wall Thickness', 1, default_value=(0.22,), min=0.08, max=0.5))
    f_basin.addParmTemplate(hou.FloatParmTemplate('cavity_depth', 'Inner Cavity Depth', 1, default_value=(0.26,), min=0.1, max=0.6))
    f_basin.addParmTemplate(hou.FloatParmTemplate('stone_chamfer', 'Stone Edge Chamfer', 1, default_value=(0.022,), min=0.005, max=0.06))
    ptg.append(f_basin)
    
    # Pillars parameters
    f_pillars = hou.FolderParmTemplate('pillars_folder', 'Pillars (Hard Surface)')
    f_pillars.addParmTemplate(hou.FloatParmTemplate('pillar_p1_height', 'Pillar 1 Height (Tall Back)', 1, default_value=(1.18,), min=0.8, max=2.5))
    f_pillars.addParmTemplate(hou.FloatParmTemplate('pillar_p2_height', 'Pillar 2 Height (Med Right)', 1, default_value=(0.96,), min=0.6, max=2.0))
    f_pillars.addParmTemplate(hou.FloatParmTemplate('pillar_p3_height', 'Pillar 3 Height (Low Front)', 1, default_value=(0.74,), min=0.4, max=1.5))
    f_pillars.addParmTemplate(hou.FloatParmTemplate('pillar_size', 'Pillar Base Footprint', 1, default_value=(0.44,), min=0.2, max=0.8))
    f_pillars.addParmTemplate(hou.FloatParmTemplate('pillar_wall_thick', 'Pillar Wall Thickness', 1, default_value=(0.075,), min=0.03, max=0.15))
    f_pillars.addParmTemplate(hou.FloatParmTemplate('pillar_chamfer', 'Pillar Edge Chamfer', 1, default_value=(0.016,), min=0.004, max=0.04))
    ptg.append(f_pillars)
    
    # Water Dynamics parameters
    f_water = hou.FolderParmTemplate('water_folder', 'Water Fluid Dynamics')
    f_water.addParmTemplate(hou.FloatParmTemplate('water_level', 'Basin Water Height', 1, default_value=(0.18,), min=0.05, max=0.35))
    f_water.addParmTemplate(hou.FloatParmTemplate('water_speed', 'Stream Flow Speed', 1, default_value=(4.2,), min=0.5, max=12.0))
    f_water.addParmTemplate(hou.FloatParmTemplate('ripple_speed', 'Basin Ripple Speed', 1, default_value=(3.0,), min=0.5, max=10.0))
    f_water.addParmTemplate(hou.FloatParmTemplate('ripple_freq', 'Ripple Spatial Frequency', 1, default_value=(32.0,), min=5.0, max=80.0))
    f_water.addParmTemplate(hou.FloatParmTemplate('ripple_amp', 'Ripple Height Amplitude', 1, default_value=(0.005,), min=0.0, max=0.025))
    f_water.addParmTemplate(hou.FloatParmTemplate('stream_width', 'Waterfall Stream Width', 1, default_value=(0.075,), min=0.02, max=0.18))
    f_water.addParmTemplate(hou.FloatParmTemplate('stream_thickness', 'Stream Fluid Thickness', 1, default_value=(0.018,), min=0.005, max=0.05))
    ptg.append(f_water)
    
    null_parms.setParmTemplateGroup(ptg)
    
    # --- 2. HARD-SURFACE BASIN MODELING ---
    # Outer box: clean manifold
    box_outer = fountain_geo.createNode('box', 'box_basin_outer')
    box_outer.parm('sizex').setExpression('ch("../CONTROLS/basin_width")')
    box_outer.parm('sizey').setExpression('ch("../CONTROLS/basin_height")')
    box_outer.parm('sizez').setExpression('ch("../CONTROLS/basin_length")')
    box_outer.parm('ty').setExpression('ch("../CONTROLS/basin_height") * 0.5')
    
    # Cavity cutter
    box_inner = fountain_geo.createNode('box', 'box_basin_inner')
    box_inner.parm('sizex').setExpression('ch("../CONTROLS/basin_width") - ch("../CONTROLS/rim_thickness") * 2.0')
    box_inner.parm('sizey').setExpression('ch("../CONTROLS/cavity_depth") * 2.0')
    box_inner.parm('sizez').setExpression('ch("../CONTROLS/basin_length") - ch("../CONTROLS/rim_thickness") * 2.0')
    box_inner.parm('ty').setExpression('ch("../CONTROLS/basin_height")')
    
    bool_basin = fountain_geo.createNode('boolean::2.0', 'bool_basin')
    bool_basin.parm('booleanop').set('subtract')
    bool_basin.setInput(0, box_outer)
    bool_basin.setInput(1, box_inner)
    
    # Crisp 45-degree chamfer bevel (single division = flat hard surface bevel)
    bevel_basin = fountain_geo.createNode('polybevel::3.0', 'bevel_basin')
    bevel_basin.setInput(0, bool_basin)
    bevel_basin.parm('offset').setExpression('ch("../CONTROLS/stone_chamfer")')
    bevel_basin.parm('divisions').set(1)
    
    wrangle_tag_basin = fountain_geo.createNode('attribwrangle', 'wrangle_tag_basin')
    wrangle_tag_basin.setInput(0, bevel_basin)
    wrangle_tag_basin.parm('snippet').set('''
    s@piece = "basin";
    ''')
    
    # --- 3. HARD-SURFACE PILLARS MODELING ---
    def make_hard_pillar(name, p_idx, height_expr, pos_x_expr, pos_z_expr, has_weir=False):
        box_out = fountain_geo.createNode('box', f'box_{name}_out')
        box_out.parm('sizex').setExpression('ch("../CONTROLS/pillar_size")')
        box_out.parm('sizey').setExpression(height_expr)
        box_out.parm('sizez').setExpression('ch("../CONTROLS/pillar_size")')
        box_out.parm('tx').setExpression(pos_x_expr)
        box_out.parm('ty').setExpression(f'({height_expr}) * 0.5')
        box_out.parm('tz').setExpression(pos_z_expr)
        
        # Hollow cavity cutter for water pool
        box_in = fountain_geo.createNode('box', f'box_{name}_in')
        box_in.parm('sizex').setExpression('ch("../CONTROLS/pillar_size") - ch("../CONTROLS/pillar_wall_thick") * 2.0')
        box_in.parm('sizey').set(0.35)
        box_in.parm('sizez').setExpression('ch("../CONTROLS/pillar_size") - ch("../CONTROLS/pillar_wall_thick") * 2.0')
        box_in.parm('tx').setExpression(pos_x_expr)
        box_in.parm('ty').setExpression(f'({height_expr}) - 0.04')
        box_in.parm('tz').setExpression(pos_z_expr)
        
        bool_p = fountain_geo.createNode('boolean::2.0', f'bool_{name}')
        bool_p.parm('booleanop').set('subtract')
        bool_p.setInput(0, box_out)
        bool_p.setInput(1, box_in)
        
        last_node = bool_p
        
        # Pour notch / weir on Pillar 3 front edge
        if has_weir:
            box_weir = fountain_geo.createNode('box', f'box_{name}_weir')
            box_weir.parm('sizex').setExpression('ch("../CONTROLS/stream_width")')
            box_weir.parm('sizey').set(0.045)
            box_weir.parm('sizez').set(0.12)
            box_weir.parm('tx').setExpression(pos_x_expr)
            box_weir.parm('ty').setExpression(f'({height_expr}) - 0.015')
            box_weir.parm('tz').setExpression(f'({pos_z_expr}) + ch("../CONTROLS/pillar_size") * 0.5')
            
            bool_weir = fountain_geo.createNode('boolean::2.0', f'bool_{name}_weir')
            bool_weir.parm('booleanop').set('subtract')
            bool_weir.setInput(0, bool_p)
            bool_weir.setInput(1, box_weir)
            last_node = bool_weir
            
        bevel_p = fountain_geo.createNode('polybevel::3.0', f'bevel_{name}')
        bevel_p.setInput(0, last_node)
        bevel_p.parm('offset').setExpression('ch("../CONTROLS/pillar_chamfer")')
        bevel_p.parm('divisions').set(1) # Sharp hard surface chamfer
        
        wrangle_p = fountain_geo.createNode('attribwrangle', f'wrangle_{name}')
        wrangle_p.setInput(0, bevel_p)
        wrangle_p.parm('snippet').set(f'''
        s@piece = "{name}";
        i@pillar_idx = {p_idx};
        ''')
        
        return wrangle_p
        
    p1 = make_hard_pillar('pillar_tall_back', 1, 'ch("../CONTROLS/pillar_p1_height")', '-0.08', '-0.16', False)
    p2 = make_hard_pillar('pillar_med_right', 2, 'ch("../CONTROLS/pillar_p2_height")', '0.28', '-0.02', False)
    p3 = make_hard_pillar('pillar_low_front', 3, 'ch("../CONTROLS/pillar_p3_height")', '-0.16', '0.24', True)
    
    # Merge all hard surface stone blocks
    merge_stone = fountain_geo.createNode('merge', 'merge_stone_blocks')
    merge_stone.setInput(0, wrangle_tag_basin)
    merge_stone.setInput(1, p1)
    merge_stone.setInput(2, p2)
    merge_stone.setInput(3, p3)
    
    # Compute crisp hard-surface vertex normals (cusp angle 40 degrees)
    normal_stone = fountain_geo.createNode('normal', 'normal_stone')
    normal_stone.setInput(0, merge_stone)
    normal_stone.parm('type').set(1) # Vertex normals
    normal_stone.parm('cuspangle').set(40.0)
    
    # Material tags and wetness attributes for stone
    wrangle_mat_stone = fountain_geo.createNode('attribwrangle', 'wrangle_mat_stone')
    wrangle_mat_stone.setInput(0, normal_stone)
    wrangle_mat_stone.parm('snippet').set('''
    s@material_tag = "M_Control_BrutalistStone_01";
    s@unreal_material = "M_Control_BrutalistStone_01";
    
    // Wetness mask: where water splashes inside basin and runs down the front face of Pillar 3
    float is_basin_wet = (@P.y < 0.22 && abs(@P.x) < 0.85 && abs(@P.z) < 0.85) ? 1.0 : 0.0;
    
    float dx = abs(@P.x - (-0.16));
    float dz = @P.z - 0.24;
    float is_waterfall_wet = (dx < 0.10 && dz > 0.20 && @P.y < 0.74) ? 1.0 : 0.0;
    
    f@wetness = clamp(is_basin_wet * 0.95 + is_waterfall_wet * 1.0, 0.0, 1.0);
    @Cd = lerp(set(0.12, 0.125, 0.13), set(0.035, 0.038, 0.04), f@wetness);
    ''')
    
    # --- 4. HIGH-FIDELITY ANIMATED WATER SYSTEM ---
    # Helper to generate a top pool with meniscus
    def make_top_pool(name, px_expr, pz_expr, height_expr):
        grid = fountain_geo.createNode('grid', f'grid_{name}')
        grid.parm('sizex').setExpression('ch("../CONTROLS/pillar_size") - ch("../CONTROLS/pillar_wall_thick") * 2.0 + 0.004')
        grid.parm('sizey').setExpression('ch("../CONTROLS/pillar_size") - ch("../CONTROLS/pillar_wall_thick") * 2.0 + 0.004')
        grid.parm('rows').set(24)
        grid.parm('cols').set(24)
        grid.parm('tx').setExpression(px_expr)
        grid.parm('ty').setExpression(f'({height_expr}) - 0.032')
        grid.parm('tz').setExpression(pz_expr)
        
        wrangle = fountain_geo.createNode('attribwrangle', f'wrangle_{name}')
        wrangle.setInput(0, grid)
        wrangle.parm('snippet').set(f'''
        float speed = chf("../CONTROLS/water_speed") * 0.5;
        float t = @Time * speed;
        
        // Gentle surface tension agitation
        float wave = sin(@P.x * 24.0 + t) * cos(@P.z * 24.0 + t * 0.85) * 0.0015;
        float micro = (anoise(set(@P.x * 40.0, t, @P.z * 40.0)) - 0.5) * 0.001;
        @P.y += wave + micro;
        
        // Velocity (swirling)
        v@v = set(-(@P.z - ({pz_expr})) * 0.05, 0.0, (@P.x - ({px_expr})) * 0.05);
        f@foam = 0.0;
        f@caustics = 0.6;
        s@piece = "{name}";
        ''')
        return wrangle
        
    pool1 = make_top_pool('pool_tall_back', '-0.08', '-0.16', 'ch("../CONTROLS/pillar_p1_height")')
    pool2 = make_top_pool('pool_med_right', '0.28', '-0.02', 'ch("../CONTROLS/pillar_p2_height")')
    pool3 = make_top_pool('pool_low_front', '-0.16', '0.24', 'ch("../CONTROLS/pillar_p3_height")')
    
    # Main Basin Water Surface Plane
    grid_basin = fountain_geo.createNode('grid', 'water_basin_surface')
    grid_basin.parm('sizex').setExpression('ch("../CONTROLS/basin_width") - ch("../CONTROLS/rim_thickness") * 2.0 + 0.005')
    grid_basin.parm('sizey').setExpression('ch("../CONTROLS/basin_length") - ch("../CONTROLS/rim_thickness") * 2.0 + 0.005')
    grid_basin.parm('rows').set(96)
    grid_basin.parm('cols').set(96)
    grid_basin.parm('ty').setExpression('ch("../CONTROLS/water_level")')
    
    wrangle_basin_water = fountain_geo.createNode('attribwrangle', 'wrangle_basin_water')
    wrangle_basin_water.setInput(0, grid_basin)
    wrangle_basin_water.parm('snippet').set('''
    float r_speed = chf("../CONTROLS/ripple_speed");
    float freq = chf("../CONTROLS/ripple_freq");
    float amp = chf("../CONTROLS/ripple_amp");
    float t = @Time * r_speed;
    
    // Impact center point where waterfall hits basin surface
    vector impact = set(-0.16, chf("../CONTROLS/water_level"), 0.24 + chf("../CONTROLS/pillar_size") * 0.5 + 0.015);
    
    float dist = distance(set(@P.x, 0, @P.z), set(impact.x, 0, impact.z));
    
    // Concentric capillary ripples radiating from plunge impact
    float decay = exp(-dist * 2.4);
    float ripple = sin(dist * freq - t * 4.0) * amp * decay;
    
    // Secondary wider wave
    float broad_wave = sin(dist * (freq * 0.35) - t * 2.0) * (amp * 0.6) * exp(-dist * 1.5);
    
    // Ambient micro-shimmer
    float shimmer = (anoise(set(@P.x * 25.0, t * 0.8, @P.z * 25.0)) - 0.5) * (amp * 0.25);
    
    @P.y += ripple + broad_wave + shimmer;
    
    // Physical flow velocity away from impact
    vector dir = normalize(set(@P.x - impact.x, 0, @P.z - impact.z) + set(0.0001, 0, 0.0001));
    v@v = dir * (0.25 * decay);
    
    // Foam intensity near waterfall base
    f@foam = smooth(0.18, 0.02, dist);
    
    // Subsurface caustics intensity
    f@caustics = clamp(1.0 + ripple * 25.0, 0.2, 2.5);
    
    s@piece = "basin_water";
    ''')
    
    # Cascading Waterfall Sheet (with volume and fluid contour)
    # Modeled as a volumetric arched fluid ribbon
    tube_wf = fountain_geo.createNode('grid', 'waterfall_ribbon')
    tube_wf.parm('sizex').setExpression('ch("../CONTROLS/stream_width")')
    tube_wf.parm('sizey').setExpression('ch("../CONTROLS/pillar_p3_height") - ch("../CONTROLS/water_level")')
    tube_wf.parm('rows').set(60)
    tube_wf.parm('cols').set(16)
    tube_wf.parm('rx').set(90)
    tube_wf.parm('tx').set(-0.16)
    tube_wf.parm('ty').setExpression('(ch("../CONTROLS/pillar_p3_height") + ch("../CONTROLS/water_level")) * 0.5')
    tube_wf.parm('tz').set(0.24 + 0.22 + 0.008)
    
    wrangle_waterfall = fountain_geo.createNode('attribwrangle', 'wrangle_waterfall')
    wrangle_waterfall.setInput(0, tube_wf)
    wrangle_waterfall.parm('snippet').set('''
    float speed = chf("../CONTROLS/water_speed");
    float t = @Time * speed;
    
    float h_top = chf("../CONTROLS/pillar_p3_height");
    float h_bot = chf("../CONTROLS/water_level");
    float norm_y = clamp((@P.y - h_bot) / (h_top - h_bot), 0.0, 1.0);
    
    // Parabolic overflow curl at top lip
    float curl = sin((1.0 - norm_y) * 3.14159) * 0.015;
    
    // Downward streaming turbulent fluid waves
    float flow1 = (anoise(set(@P.x * 35.0, @P.y * 18.0 - t * 8.0, t * 0.5)) - 0.5) * 0.008;
    float flow2 = (anoise(set(@P.x * 60.0, @P.y * 40.0 - t * 14.0, t * 1.2)) - 0.5) * 0.004;
    
    // Surface thickness & displacement along Z
    @P.z += curl + flow1 + flow2;
    
    // Stream slightly narrows in freefall due to acceleration
    float waist = 1.0 - sin(norm_y * 3.14159 * 0.5) * 0.15;
    @P.x = -0.16 + (@P.x - (-0.16)) * waist;
    
    // Downward fluid velocity
    v@v = set(0.0, -3.2 * (1.0 + (1.0 - norm_y) * 0.8), 0.35);
    
    // Aeration / foam increases as water falls and breaks up
    f@foam = (1.0 - norm_y) * 0.45;
    f@caustics = 1.8;
    
    s@piece = "waterfall_sheet";
    ''')
    
    # Extrude waterfall slightly to give it real optical fluid volume
    extrude_wf = fountain_geo.createNode('polyextrude::2.0', 'extrude_waterfall')
    extrude_wf.setInput(0, wrangle_waterfall)
    extrude_wf.parm('dist').setExpression('ch("../CONTROLS/stream_thickness")')
    extrude_wf.parm('outputback').set(1)
    
    # Merge all water geometry
    merge_water = fountain_geo.createNode('merge', 'merge_all_water')
    merge_water.setInput(0, pool1)
    merge_water.setInput(1, pool2)
    merge_water.setInput(2, pool3)
    merge_water.setInput(3, wrangle_basin_water)
    merge_water.setInput(4, extrude_wf)
    
    # Compute smooth vertex normals for water
    normal_water = fountain_geo.createNode('normal', 'normal_water')
    normal_water.setInput(0, merge_water)
    normal_water.parm('type').set(1) # Vertex normals
    normal_water.parm('cuspangle').set(60.0)
    
    wrangle_mat_water = fountain_geo.createNode('attribwrangle', 'wrangle_mat_water')
    wrangle_mat_water.setInput(0, normal_water)
    wrangle_mat_water.parm('snippet').set('''
    s@material_tag = "M_Control_FountainWater_01";
    s@unreal_material = "M_Control_FountainWater_01";
    f@wetness = 1.0;
    
    // Realistic viewport water tint (dark refractive glass blue-green + white foam highlight)
    vector base_water = set(0.06, 0.12, 0.16);
    vector foam_color = set(0.85, 0.92, 0.96);
    @Cd = lerp(base_water, foam_color, clamp(f@foam * 1.5, 0.0, 1.0));
    ''')
    
    # --- 5. ASSET COMBINATION, UV UNWRAP, AND TEXEL DENSITY ---
    merge_complete = fountain_geo.createNode('merge', 'merge_fountain_asset')
    merge_complete.setInput(0, wrangle_mat_stone)
    merge_complete.setInput(1, wrangle_mat_water)
    
    uv_unwrap = fountain_geo.createNode('uvautoseam', 'uv_autoseam')
    uv_unwrap.setInput(0, merge_complete)
    
    uv_flatten = fountain_geo.createNode('uvflatten::3.0', 'uv_flatten')
    uv_flatten.setInput(0, uv_unwrap)
    
    uv_layout = fountain_geo.createNode('uvlayout::3.0', 'uv_layout')
    uv_layout.setInput(0, uv_flatten)
    uv_layout.parm('padding').set(4) # 4 pixels packing margin
    
    out_node = fountain_geo.createNode('null', 'OUT_FOUNTAIN_ASSET')
    out_node.setInput(0, uv_layout)
    out_node.setDisplayFlag(True)
    out_node.setRenderFlag(True)
    
    fountain_geo.layoutChildren()
    return fountain_geo
