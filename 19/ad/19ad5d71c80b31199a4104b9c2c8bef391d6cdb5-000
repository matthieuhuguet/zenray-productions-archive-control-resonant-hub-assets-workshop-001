"""
Procedural modeling of the Control Brutalist Fountain asset.
Builds the procedural SOP network with:
- Outer chiseled stone basin
- 3 tiered monolithic pillars with hollow top reservoirs
- Pour notch and animated water cascade
- Animated basin water with impact ripples
- UV unwrapping and Texel density normalization
- Material classification (M_Control_BrutalistStone_01, M_Control_FountainWater_01) and wetness mask
- Pure geometry (zero baked Cd in final UVs/geo per Components1.md doctrine)
"""
import hou
import os

def build_fountain():
    obj = hou.node('/obj')
    
    # Clean previous geo if exists
    fountain_geo = obj.node('Control_Brutalist_Fountain')
    if fountain_geo:
        fountain_geo.destroy()
        
    fountain_geo = obj.createNode('geo', 'Control_Brutalist_Fountain')
    
    # Delete default file node inside
    for child in fountain_geo.children():
        child.destroy()
        
    # --- 1. PARAMETERS CONTROLLER ---
    null_parms = fountain_geo.createNode('null', 'CONTROLS')
    ptg = null_parms.parmTemplateGroup()
    
    # Add folder for Basin
    f_basin = hou.FolderParmTemplate('basin_folder', 'Basin')
    f_basin.addParmTemplate(hou.FloatParmTemplate('basin_width', 'Basin Width', 1, default_value=(2.1,), min=1.0, max=4.0))
    f_basin.addParmTemplate(hou.FloatParmTemplate('basin_length', 'Basin Length', 1, default_value=(2.1,), min=1.0, max=4.0))
    f_basin.addParmTemplate(hou.FloatParmTemplate('basin_height', 'Basin Height', 1, default_value=(0.38,), min=0.2, max=1.0))
    f_basin.addParmTemplate(hou.FloatParmTemplate('rim_thickness', 'Rim Thickness', 1, default_value=(0.22,), min=0.08, max=0.5))
    f_basin.addParmTemplate(hou.FloatParmTemplate('cavity_depth', 'Cavity Depth', 1, default_value=(0.26,), min=0.1, max=0.6))
    ptg.append(f_basin)
    
    # Add folder for Pillars
    f_pillars = hou.FolderParmTemplate('pillars_folder', 'Pillars')
    f_pillars.addParmTemplate(hou.FloatParmTemplate('pillar_p1_height', 'Pillar 1 Height (Tall Back)', 1, default_value=(1.18,), min=0.8, max=2.5))
    f_pillars.addParmTemplate(hou.FloatParmTemplate('pillar_p2_height', 'Pillar 2 Height (Med Right)', 1, default_value=(0.96,), min=0.6, max=2.0))
    f_pillars.addParmTemplate(hou.FloatParmTemplate('pillar_p3_height', 'Pillar 3 Height (Low Front)', 1, default_value=(0.74,), min=0.4, max=1.5))
    f_pillars.addParmTemplate(hou.FloatParmTemplate('pillar_size', 'Pillar Base Size', 1, default_value=(0.44,), min=0.2, max=0.8))
    f_pillars.addParmTemplate(hou.FloatParmTemplate('pillar_wall_thick', 'Pillar Wall Thickness', 1, default_value=(0.075,), min=0.03, max=0.15))
    ptg.append(f_pillars)
    
    # Add folder for Chisel / Stone Details
    f_chisel = hou.FolderParmTemplate('chisel_folder', 'Stone Chisel')
    f_chisel.addParmTemplate(hou.FloatParmTemplate('chisel_roughness', 'Chisel Amplitude', 1, default_value=(0.024,), min=0.0, max=0.08))
    f_chisel.addParmTemplate(hou.FloatParmTemplate('chisel_freq', 'Chisel Frequency', 1, default_value=(12.0,), min=1.0, max=40.0))
    f_chisel.addParmTemplate(hou.FloatParmTemplate('edge_bevel', 'Edge Bevel Width', 1, default_value=(0.024,), min=0.005, max=0.1))
    ptg.append(f_chisel)
    
    # Add folder for Water Animation
    f_water = hou.FolderParmTemplate('water_folder', 'Water Flow & Ripples')
    f_water.addParmTemplate(hou.FloatParmTemplate('water_speed', 'Flow Speed', 1, default_value=(3.5,), min=0.1, max=10.0))
    f_water.addParmTemplate(hou.FloatParmTemplate('ripple_freq', 'Ripple Frequency', 1, default_value=(28.0,), min=5.0, max=80.0))
    f_water.addParmTemplate(hou.FloatParmTemplate('ripple_amp', 'Ripple Amplitude', 1, default_value=(0.006,), min=0.0, max=0.03))
    ptg.append(f_water)
    
    null_parms.setParmTemplateGroup(ptg)
    
    # --- 2. BASIN MODELING ---
    box_outer = fountain_geo.createNode('box', 'box_basin_outer')
    box_outer.parm('sizex').setExpression('ch("../CONTROLS/basin_width")')
    box_outer.parm('sizey').setExpression('ch("../CONTROLS/basin_height")')
    box_outer.parm('sizez').setExpression('ch("../CONTROLS/basin_length")')
    box_outer.parm('ty').setExpression('ch("../CONTROLS/basin_height") * 0.5')
    # Extra subdivisions for organic stone deformation
    box_outer.parm('divratex').set(8)
    box_outer.parm('divratey').set(6)
    box_outer.parm('divratez').set(8)
    
    # Inner cavity cutter
    box_inner = fountain_geo.createNode('box', 'box_basin_inner')
    box_inner.parm('sizex').setExpression('ch("../CONTROLS/basin_width") - ch("../CONTROLS/rim_thickness") * 2.0')
    box_inner.parm('sizey').setExpression('ch("../CONTROLS/cavity_depth") * 2.0')
    box_inner.parm('sizez').setExpression('ch("../CONTROLS/basin_length") - ch("../CONTROLS/rim_thickness") * 2.0')
    box_inner.parm('ty').setExpression('ch("../CONTROLS/basin_height")')
    
    # Boolean subtract cavity from outer basin
    bool_basin = fountain_geo.createNode('boolean::2.0', 'bool_basin')
    bool_basin.parm('booleanop').set('subtract')
    bool_basin.setInput(0, box_outer)
    bool_basin.setInput(1, box_inner)
    
    # Bevel basin edges
    bevel_basin = fountain_geo.createNode('polybevel::3.0', 'bevel_basin')
    bevel_basin.setInput(0, bool_basin)
    bevel_basin.parm('offset').setExpression('ch("../CONTROLS/edge_bevel") * 1.5')
    bevel_basin.parm('divisions').set(2)
    
    # Chisel noise on basin (brutalist rock cleavage)
    wrangle_chisel_basin = fountain_geo.createNode('attribwrangle', 'wrangle_chisel_basin')
    wrangle_chisel_basin.setInput(0, bevel_basin)
    wrangle_chisel_basin.parm('snippet').set('''
    float amp = chf("../CONTROLS/chisel_roughness");
    float freq = chf("../CONTROLS/chisel_freq");
    
    // Large rock faceting
    vector p_noise = @P * freq * 0.35;
    vector n1 = vector(anoise(p_noise));
    
    // Medium cleavage planes
    vector n2 = vector(anoise(@P * freq));
    
    // Chisel displacement along normal
    float disp = (n1.x * 0.6 + n2.x * 0.4) * amp;
    
    // Keep bottom flat on floor
    if (@P.y > 0.01) {
        @P += @N * disp;
    }
    
    s@piece = "basin";
    ''')
    
    # --- 3. PILLARS MODELING ---
    def make_pillar_node(name, p_idx, height_expr, pos_x_expr, pos_z_expr, has_notch=False):
        box_p_out = fountain_geo.createNode('box', f'box_{name}_out')
        box_p_out.parm('sizex').setExpression('ch("../CONTROLS/pillar_size")')
        box_p_out.parm('sizey').setExpression(height_expr)
        box_p_out.parm('sizez').setExpression('ch("../CONTROLS/pillar_size")')
        box_p_out.parm('tx').setExpression(pos_x_expr)
        box_p_out.parm('ty').setExpression(f'({height_expr}) * 0.5')
        box_p_out.parm('tz').setExpression(pos_z_expr)
        box_p_out.parm('divratex').set(4)
        box_p_out.parm('divratey').set(12)
        box_p_out.parm('divratez').set(4)
        
        # Inner hollow cavity cutter
        box_p_in = fountain_geo.createNode('box', f'box_{name}_in')
        box_p_in.parm('sizex').setExpression('ch("../CONTROLS/pillar_size") - ch("../CONTROLS/pillar_wall_thick") * 2.0')
        box_p_in.parm('sizey').set(0.35)
        box_p_in.parm('sizez').setExpression('ch("../CONTROLS/pillar_size") - ch("../CONTROLS/pillar_wall_thick") * 2.0')
        box_p_in.parm('tx').setExpression(pos_x_expr)
        box_p_in.parm('ty').setExpression(f'({height_expr}) - 0.05')
        box_p_in.parm('tz').setExpression(pos_z_expr)
        
        bool_p = fountain_geo.createNode('boolean::2.0', f'bool_{name}')
        bool_p.parm('booleanop').set('subtract')
        bool_p.setInput(0, box_p_out)
        bool_p.setInput(1, box_p_in)
        
        last_node = bool_p
        
        # Pour notch on Pillar 3 (front lip)
        if has_notch:
            box_notch = fountain_geo.createNode('box', f'box_{name}_notch')
            box_notch.parm('sizex').set(0.065)
            box_notch.parm('sizey').set(0.045)
            box_notch.parm('sizez').set(0.12)
            box_notch.parm('tx').setExpression(pos_x_expr)
            box_notch.parm('ty').setExpression(f'({height_expr}) - 0.01')
            box_notch.parm('tz').setExpression(f'({pos_z_expr}) + ch("../CONTROLS/pillar_size") * 0.5')
            
            bool_notch = fountain_geo.createNode('boolean::2.0', f'bool_{name}_notch')
            bool_notch.parm('booleanop').set('subtract')
            bool_notch.setInput(0, bool_p)
            bool_notch.setInput(1, box_notch)
            last_node = bool_notch
            
        bevel_p = fountain_geo.createNode('polybevel::3.0', f'bevel_{name}')
        bevel_p.setInput(0, last_node)
        bevel_p.parm('offset').setExpression('ch("../CONTROLS/edge_bevel")')
        bevel_p.parm('divisions').set(2)
        
        wrangle_chisel_p = fountain_geo.createNode('attribwrangle', f'wrangle_chisel_{name}')
        wrangle_chisel_p.setInput(0, bevel_p)
        wrangle_chisel_p.parm('snippet').set(f'''
        float amp = chf("../CONTROLS/chisel_roughness");
        float freq = chf("../CONTROLS/chisel_freq");
        
        vector p_noise = @P * freq * 0.4;
        vector n1 = vector(anoise(p_noise));
        vector n2 = vector(anoise(@P * freq * 1.5));
        
        // Vertical cleavage lines (strata)
        float strata = sin(@P.y * 35.0) * 0.003;
        
        float disp = (n1.x * 0.6 + n2.x * 0.4) * amp + strata;
        
        if (@P.y > 0.02) {{
            @P += @N * disp;
        }}
        
        s@piece = "{name}";
        int@pillar_idx = {p_idx};
        ''')
        
        return wrangle_chisel_p
        
    # Pillar 1 (Tallest, Back-Center):
    p1 = make_pillar_node('pillar_tall_back', 1, 'ch("../CONTROLS/pillar_p1_height")', '-0.08', '-0.16', False)
    
    # Pillar 2 (Medium, Front-Right):
    p2 = make_pillar_node('pillar_med_right', 2, 'ch("../CONTROLS/pillar_p2_height")', '0.28', '-0.02', False)
    
    # Pillar 3 (Lowest, Front-Left):
    p3 = make_pillar_node('pillar_low_front', 3, 'ch("../CONTROLS/pillar_p3_height")', '-0.16', '0.24', True)
    
    # Merge all stone geometry
    merge_stone = fountain_geo.createNode('merge', 'merge_stone_blocks')
    merge_stone.setInput(0, wrangle_chisel_basin)
    merge_stone.setInput(1, p1)
    merge_stone.setInput(2, p2)
    merge_stone.setInput(3, p3)
    
    # Normal computation for stone
    normal_stone = fountain_geo.createNode('normal', 'normal_stone')
    normal_stone.setInput(0, merge_stone)
    normal_stone.parm('type').set(0) # Vertices
    
    # Material and classification attributes for stone
    wrangle_mat_stone = fountain_geo.createNode('attribwrangle', 'wrangle_mat_stone')
    wrangle_mat_stone.setInput(0, normal_stone)
    wrangle_mat_stone.parm('snippet').set('''
    s@material_tag = "M_Control_BrutalistStone_01";
    s@unreal_material = "M_Control_BrutalistStone_01";
    
    // Compute wetness mask:
    // Wet where water runs down the front face of Pillar 3 (x ~ -0.16, z > 0.24, y < 0.74)
    // and inside the lower basin (y < 0.24 and inside cavity)
    float is_basin_wet = (@P.y < 0.24 && abs(@P.x) < 0.85 && abs(@P.z) < 0.85) ? 1.0 : 0.0;
    
    float dx = abs(@P.x - (-0.16));
    float dz = @P.z - 0.24;
    float is_waterfall_wet = (dx < 0.16 && dz > 0.18 && @P.y < 0.74) ? 1.0 : 0.0;
    
    @f@wetness = clamp(is_basin_wet * 0.95 + is_waterfall_wet * 1.0, 0.0, 1.0);
    ''')
    
    # --- 4. WATER MODELING & ANIMATION ---
    # A. Top pool 1 (Tall)
    grid_p1 = fountain_geo.createNode('grid', 'water_pool_p1')
    grid_p1.parm('sizex').setExpression('ch("../CONTROLS/pillar_size") - ch("../CONTROLS/pillar_wall_thick") * 2.0')
    grid_p1.parm('sizey').setExpression('ch("../CONTROLS/pillar_size") - ch("../CONTROLS/pillar_wall_thick") * 2.0')
    grid_p1.parm('rows').set(16)
    grid_p1.parm('cols').set(16)
    grid_p1.parm('tx').set(-0.08)
    grid_p1.parm('ty').setExpression('ch("../CONTROLS/pillar_p1_height") - 0.04')
    grid_p1.parm('tz').set(-0.16)
    
    # B. Top pool 2 (Medium)
    grid_p2 = fountain_geo.createNode('grid', 'water_pool_p2')
    grid_p2.parm('sizex').setExpression('ch("../CONTROLS/pillar_size") - ch("../CONTROLS/pillar_wall_thick") * 2.0')
    grid_p2.parm('sizey').setExpression('ch("../CONTROLS/pillar_size") - ch("../CONTROLS/pillar_wall_thick") * 2.0')
    grid_p2.parm('rows').set(16)
    grid_p2.parm('cols').set(16)
    grid_p2.parm('tx').set(0.28)
    grid_p2.parm('ty').setExpression('ch("../CONTROLS/pillar_p2_height") - 0.04')
    grid_p2.parm('tz').set(-0.02)
    
    # C. Top pool 3 (Lowest)
    grid_p3 = fountain_geo.createNode('grid', 'water_pool_p3')
    grid_p3.parm('sizex').setExpression('ch("../CONTROLS/pillar_size") - ch("../CONTROLS/pillar_wall_thick") * 2.0')
    grid_p3.parm('sizey').setExpression('ch("../CONTROLS/pillar_size") - ch("../CONTROLS/pillar_wall_thick") * 2.0')
    grid_p3.parm('rows').set(16)
    grid_p3.parm('cols').set(16)
    grid_p3.parm('tx').set(-0.16)
    grid_p3.parm('ty').setExpression('ch("../CONTROLS/pillar_p3_height") - 0.035')
    grid_p3.parm('tz').set(0.24)
    
    # D. Basin Main Water Plane
    grid_basin = fountain_geo.createNode('grid', 'water_pool_basin')
    grid_basin.parm('sizex').setExpression('ch("../CONTROLS/basin_width") - ch("../CONTROLS/rim_thickness") * 2.0')
    grid_basin.parm('sizey').setExpression('ch("../CONTROLS/basin_length") - ch("../CONTROLS/rim_thickness") * 2.0')
    grid_basin.parm('rows').set(64)
    grid_basin.parm('cols').set(64)
    grid_basin.parm('ty').set(0.18)
    
    # E. Waterfall Sheet from Pillar 3 Notch down to Basin Water
    curve_wf = fountain_geo.createNode('grid', 'waterfall_sheet')
    curve_wf.parm('sizex').set(0.09)
    curve_wf.parm('sizey').setExpression('ch("../CONTROLS/pillar_p3_height") - 0.18')
    curve_wf.parm('rows').set(40)
    curve_wf.parm('cols').set(12)
    curve_wf.parm('rx').set(90)
    curve_wf.parm('tx').set(-0.16)
    curve_wf.parm('ty').setExpression('(ch("../CONTROLS/pillar_p3_height") + 0.18) * 0.5')
    curve_wf.parm('tz').set(0.24 + 0.22 + 0.005)
    
    merge_pools = fountain_geo.createNode('merge', 'merge_water_pools')
    merge_pools.setInput(0, grid_p1)
    merge_pools.setInput(1, grid_p2)
    merge_pools.setInput(2, grid_p3)
    merge_pools.setInput(3, grid_basin)
    
    wrangle_anim_pools = fountain_geo.createNode('attribwrangle', 'wrangle_anim_water_pools')
    wrangle_anim_pools.setInput(0, merge_pools)
    wrangle_anim_pools.parm('snippet').set('''
    float speed = chf("../CONTROLS/water_speed");
    float freq = chf("../CONTROLS/ripple_freq");
    float amp = chf("../CONTROLS/ripple_amp");
    float t = @Time * speed;
    
    vector impact = set(-0.16, 0.18, 0.465);
    
    if (@P.y < 0.3) {
        float dist = distance(set(@P.x, 0, @P.z), set(impact.x, 0, impact.z));
        float decay = exp(-dist * 2.5);
        float wave = sin(dist * freq - t * 4.0) * amp * decay;
        float micro = anoise(@P * 25.0 + set(t, 0, t)) * amp * 0.3;
        @P.y += wave + micro;
    } else {
        float wave = sin(@P.x * 20.0 + t) * cos(@P.z * 20.0 + t * 0.8) * amp * 0.4;
        @P.y += wave;
    }
    
    s@piece = "water_pool";
    s@material_tag = "M_Control_FountainWater_01";
    s@unreal_material = "M_Control_FountainWater_01";
    f@wetness = 1.0;
    ''')
    
    wrangle_anim_wf = fountain_geo.createNode('attribwrangle', 'wrangle_anim_waterfall')
    wrangle_anim_wf.setInput(0, curve_wf)
    wrangle_anim_wf.parm('snippet').set('''
    float speed = chf("../CONTROLS/water_speed");
    float t = @Time * speed;
    
    float flow = anoise(set(@P.x * 30.0, @P.y * 15.0 - t * 6.0, @P.z * 30.0));
    float height_norm = clamp((@P.y - 0.18) / (chf("../CONTROLS/pillar_p3_height") - 0.18), 0.0, 1.0);
    float gravity_curl = sin((1.0 - height_norm) * 3.14159) * 0.012;
    
    @P.z += gravity_curl + flow * 0.005;
    
    s@piece = "waterfall";
    s@material_tag = "M_Control_FountainWater_01";
    s@unreal_material = "M_Control_FountainWater_01";
    f@wetness = 1.0;
    ''')
    
    merge_water = fountain_geo.createNode('merge', 'merge_all_water')
    merge_water.setInput(0, wrangle_anim_pools)
    merge_water.setInput(1, wrangle_anim_wf)
    
    normal_water = fountain_geo.createNode('normal', 'normal_water')
    normal_water.setInput(0, merge_water)
    normal_water.parm('type').set(0)
    
    # --- 5. ASSET COMBINATION, UV UNWRAP, AND TEXEL DENSITY ---
    merge_all = fountain_geo.createNode('merge', 'merge_asset_complete')
    merge_all.setInput(0, wrangle_mat_stone)
    merge_all.setInput(1, normal_water)
    
    uv_unwrap = fountain_geo.createNode('uvautoseam', 'uv_autoseam')
    uv_unwrap.setInput(0, merge_all)
    
    uv_flatten = fountain_geo.createNode('uvflatten::3.0', 'uv_flatten')
    uv_flatten.setInput(0, uv_unwrap)
    
    uv_layout = fountain_geo.createNode('uvlayout::3.0', 'uv_layout')
    uv_layout.setInput(0, uv_flatten)
    uv_layout.parm('packtarget').set(0)
    uv_layout.parm('padding').set(0.01)
    
    out_node = fountain_geo.createNode('null', 'OUT_FOUNTAIN_ASSET')
    out_node.setInput(0, uv_layout)
    out_node.setDisplayFlag(True)
    out_node.setRenderFlag(True)
    
    fountain_geo.layoutChildren()
    return fountain_geo
