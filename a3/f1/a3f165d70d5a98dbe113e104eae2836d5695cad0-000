import sys
import os
import json
import subprocess

def run_hom(code):
    cmd = ["python3", "/Users/zenray/.claude/Memory1/Houdini/MCP/zrhoudini.py", "hom", code, "live"]
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode != 0:
        print("Subprocess error:", res.stderr)
        return {"ok": False, "error": res.stderr}
    try:
        return json.loads(res.stdout)
    except Exception as e:
        print("JSON parse error:", e, "Raw:", res.stdout)
        return {"ok": False, "raw": res.stdout}

